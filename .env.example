# Copy to .env and fill in. Never commit the filled-in file.
#
# Free tiers are sufficient for all of these. The app is intended to degrade
# rather than fail when an optional provider is absent — a missing key should
# blank one panel, not the dashboard.

# --- Vessel tracking -------------------------------------------------------
# https://aisstream.io — free, requires signup
AISSTREAM_API_KEY=

# https://www.aishub.net — optional, alternative AIS source
AISHUB_USERNAME=

# --- Flight tracking -------------------------------------------------------
# https://opensky-network.org — OAuth2 client credentials.
# Note these are distinct from the account login below; rotating the account
# password does NOT invalidate an issued client secret.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Legacy basic-auth login. Only needed if not using OAuth2 above.
OPENSKY_USER=
OPENSKY_PASS=

# --- Market and news data --------------------------------------------------
# https://site.financialmodelingprep.com — free tier is rate limited
FMP_API_KEY=

# https://gnews.io — optional
GNEWS_API_KEY=
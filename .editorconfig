# Baseline whitespace rules, applied by the editor before any formatter runs.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces is a hard line break in Markdown — stripping it silently
# reflows paragraphs.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab